{
  "entities": {
    "Role": {
      "title": "Role",
      "description": "App role configuration for different target audiences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "themeColor": { "type": "string" },
        "icon": { "type": "string" },
        "description": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string", "enum": ["citizens", "business", "admin", "leadership", "community"] },
        "features": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["id", "name", "themeColor", "slug"]
    },
    "User": {
      "title": "User",
      "description": "System user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "departmentId": { "type": "string" },
        "assignedSections": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "profileImageUrl": { "type": "string" }
      },
      "required": ["uid", "role", "isActive"]
    },
    "Department": {
      "title": "Department",
      "description": "Government or service department",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "parentDepartmentId": { "type": "string" },
        "managerUid": { "type": "string" }
      },
      "required": ["name", "category"]
    },
    "CitizenVerification": {
      "title": "Citizen Verification",
      "description": "Temporary storage for phone verification OTPs",
      "type": "object",
      "properties": {
        "phoneNumber": { "type": "string" },
        "otpCode": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "verified": { "type": "boolean" }
      },
      "required": ["phoneNumber", "otpCode", "expiresAt", "verified"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "System-wide activity logs for security and monitoring",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "path": { "type": "string" },
        "ip": { "type": "string" }
      },
      "required": ["userId", "action", "timestamp"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app real-time notification",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "link": { "type": "string" }
      },
      "required": ["userId", "title", "message", "createdAt", "read"]
    },
    "Report": {
      "title": "Report",
      "description": "Citizen compliance or infrastructure report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "department": { "type": "string" },
        "classification": { "type": "string" },
        "location": { "type": "array", "items": { "type": "number" } },
        "imageUrl": { "type": "string" },
        "audioUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_verification", "pending_operator", "pending_official", "assigned", "in_progress", "under_execution", "resolved_pending_rating", "resolved", "rejected", "needs_info"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "description", "status", "createdAt"]
    },
    "ClarificationRequest": {
      "title": "Clarification Request",
      "description": "Council request for information from departments or admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "councilId": { "type": "string" },
        "targetDepartment": { "type": "string" },
        "subject": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "replied"] },
        "reply": { "type": "string" },
        "repliedBy": { "type": "string" },
        "repliedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["councilId", "subject", "content", "status", "createdAt"]
    },
    "JournalistCommentRequest": {
      "title": "Journalist Comment Request",
      "description": "Requests from journalists to departments regarding specific reports",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "journalistId": { "type": "string" },
        "reportId": { "type": "string" },
        "targetDepartment": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "replied"] },
        "deadline": { "type": "string", "format": "date-time" },
        "officialReply": { "type": "string" },
        "repliedBy": { "type": "string" },
        "repliedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["journalistId", "reportId", "targetDepartment", "content", "status", "deadline", "createdAt"]
    },
    "NeighborhoodDissatisfactionReport": {
      "title": "Neighborhood Dissatisfaction Report",
      "description": "Reports from neighborhood committees about general community dissatisfaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "neighborhoodId": { "type": "string" },
        "neighborhoodName": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["neighborhoodId", "neighborhoodName", "title", "content", "status", "createdAt"]
    }
  },
  "firestore": {
    "/neighborhood_dissatisfaction_reports/{reportId}": {
      "schema": "NeighborhoodDissatisfactionReport",
      "description": "Community dissatisfaction reports for the General Manager"
    },
    "/clarification_requests/{requestId}": {
      "schema": "ClarificationRequest",
      "description": "Requests from local council to departments"
    },
    "/journalist_comment_requests/{requestId}": {
      "schema": "JournalistCommentRequest",
      "description": "Official requests for comments from journalists"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Main collection for all citizen reports"
    },
    "/roles/{roleId}": {
      "schema": "Role",
      "description": "Collection of available app roles"
    },
    "/users/{uid}": {
      "schema": "User",
      "description": "System users"
    },
    "/departments/{departmentId}": {
      "schema": "Department",
      "description": "Government departments"
    },
    "/citizen_verification/{phoneNumber}": {
      "schema": "CitizenVerification",
      "description": "Phone verification records"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Admin security logs"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    }
  }
}
