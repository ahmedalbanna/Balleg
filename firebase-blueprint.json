{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing role and basic info.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "nationalId": { "type": "string" }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "A citizen report.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "department": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "type": { "type": "string" },
        "location": { "type": "string" },
        "images": { "type": "array" }
      },
      "required": ["userId", "title", "description", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "System audit logs.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "link": { "type": "string" }
      },
      "required": ["userId", "title", "message", "read", "createdAt"]
    },
    "Role": {
      "title": "Role",
      "description": "System roles metadata.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "Clarification": {
      "title": "Clarification",
      "description": "Clarifications requested by journalists, councils or neighborhoods.",
      "type": "object",
      "properties": {
        "reportId": { "type": "string" },
        "text": { "type": "string" },
        "requestedBy": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "response": { "type": "string" }
      },
      "required": ["reportId", "text", "requestedBy", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Citizen reports."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable system audit logs."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Notifications for users."
    },
    "/roles/{roleId}": {
      "schema": { "$ref": "#/entities/Role" },
      "description": "Available roles in the platform."
    },
    "/clarifications/{clarificationId}": {
      "schema": { "$ref": "#/entities/Clarification" },
      "description": "Requests for clarification."
    }
  }
}
