rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidRole(data) {
      return data.keys().hasAll(['id', 'name', 'themeColor']) &&
             data.id is string &&
             data.name is string &&
             data.themeColor is string;
    }

    match /roles/{roleId} {
      allow read: if true;
      allow write: if false; // Only admin via console should ideally write roles for this demo
    }
  }
}
