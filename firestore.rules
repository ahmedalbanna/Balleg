rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'role', 'isActive']) &&
             data.uid == request.auth.uid &&
             data.role is string && data.role.size() <= 64 &&
             data.isActive is bool &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 20)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('departmentId' in data) || (data.departmentId is string && data.departmentId.size() <= 100)) &&
             (!('profileImageUrl' in data) || (data.profileImageUrl is string && data.profileImageUrl.size() <= 512)) &&
             (!('updatedAt' in data) || data.updatedAt == request.time) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('lastLoginAt' in data) || data.lastLoginAt is timestamp);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['userId', 'action', 'timestamp']) &&
             data.keys().size() <= 7 &&
             data.userId == request.auth.uid &&
             data.action is string && data.action.size() <= 64 &&
             data.timestamp == request.time &&
             (!('details' in data) || (data.details is string && data.details.size() <= 2000)) &&
             (!('path' in data) || (data.path is string && data.path.size() <= 256));
    }

    // --- Collection Rules ---

    match /roles/{roleId} {
      allow read: if true;
      allow write: if false;
    }

    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();

      allow create: if isOwner(uid) && isValidId(uid) && isValidUser(incoming()) && 
                       incoming().createdAt == request.time;

      allow update: if isOwner(uid) && isValidId(uid) && isValidUser(incoming()) && (
        // Action: Self Profile Update
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'profileImageUrl', 'lastLoginAt', 'updatedAt', 'email', 'phoneNumber'
        ]) &&
        incoming().role == existing().role &&
        incoming().isActive == existing().isActive
      ) || isAdmin();
      
      allow delete: if isAdmin();
    }

    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /citizen_verification/{phoneNumber} {
      // Very strict for phone verification
      allow get: if false; 
      allow create: if isSignedIn() && incoming().phoneNumber == phoneNumber && 
                       incoming().keys().hasAll(['phoneNumber', 'otpCode', 'verified']) &&
                       incoming().verified == false;
      allow update: if false; 
    }
  }
}
