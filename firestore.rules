rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'role', 'isActive']) &&
             (data.uid == request.auth.uid || isAdmin()) &&
             data.role is string && data.role.size() <= 64 &&
             data.isActive is bool &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 20)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('departmentId' in data) || (data.departmentId is string && data.departmentId.size() <= 100)) &&
             (!('profileImageUrl' in data) || (data.profileImageUrl is string && data.profileImageUrl.size() <= 512)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('lastLoginAt' in data) || data.lastLoginAt is timestamp);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['userId', 'action', 'timestamp']) &&
             data.keys().size() <= 8 &&
             data.userId == request.auth.uid &&
             data.action is string && data.action.size() <= 64 &&
             data.timestamp is timestamp &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 256)) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 2000)) &&
             (!('path' in data) || (data.path is string && data.path.size() <= 256));
    }

    // --- Collection Rules ---

    match /roles/{roleId} {
      allow read: if true;
      allow write: if false;
    }

    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isSignedIn(); // Allow creating notifications for others (e.g. system bot)
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();

      allow create: if (isOwner(uid) || isAdmin()) && isValidId(uid) && isValidUser(incoming()) && 
                       incoming().createdAt is timestamp;

      allow update: if (isOwner(uid) && isValidId(uid) && isValidUser(incoming()) && (
        // Action: Self Profile Update
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'profileImageUrl', 'lastLoginAt', 'updatedAt', 'email', 'phoneNumber'
        ]) &&
        incoming().role == existing().role &&
        incoming().isActive == existing().isActive
      )) || isAdmin();
      
      allow delete: if isAdmin();
    }

    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /citizen_verification/{phoneNumber} {
      // Very strict for phone verification
      allow get: if false; 
      allow create: if isSignedIn() && incoming().phoneNumber == phoneNumber && 
                       incoming().keys().hasAll(['phoneNumber', 'otpCode', 'verified']) &&
                       incoming().verified == false;
      allow update: if false; 
    }

    function isValidReport(data) {
      return data.keys().hasAll(['description', 'type', 'status', 'userId']) &&
             (!('latitude' in data) || data.latitude is number) &&
             (!('longitude' in data) || data.longitude is number) &&
             (!('audioUrl' in data) || data.audioUrl is string) &&
             (!('imageUrl' in data) || (data.imageUrl is string || data.imageUrl == null)) &&
             (!('sponsorId' in data) || data.sponsorId is string) &&
             (!('sponsorName' in data) || data.sponsorName is string) &&
             (!('sponsorDate' in data) || data.sponsorDate is string) &&
             (!('rating' in data) || data.rating is number) &&
             (!('department' in data) || (data.department is string || data.department == null)) &&
             (!('feedback' in data) || data.feedback is string) &&
             (!('reroutedReason' in data) || data.reroutedReason is string) &&
             (!('assignedTo' in data) || data.assignedTo is string) &&
             (!('bids' in data) || data.bids is list) &&
             (!('resolutionImageUrl' in data) || data.resolutionImageUrl is string) &&
             (!('rejectReason' in data) || data.rejectReason is string) &&
             (!('rejectDetails' in data) || data.rejectDetails is string) &&
             (!('priority' in data) || data.priority is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('aiAnalysis' in data) || data.aiAnalysis is map || data.aiAnalysis == null) &&
             (!('location' in data) || data.location is list) &&
             (!('id' in data) || data.id is string) &&
             (!('isPrivateService' in data) || data.isPrivateService is bool) &&
             (!('isAnonymous' in data) || data.isAnonymous is bool);
    }

    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidReport(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidReport(incoming()) && (
        (incoming().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['description', 'rating', 'feedback', 'status', 'updatedAt', 'reroutedReason', 'assignedTo'])) ||
        // Allow merchants to sponsor a report
        (incoming().diff(existing()).affectedKeys().hasOnly(['sponsorId', 'sponsorName', 'sponsorDate'])) ||
        // Allow operators/officials to update
        (isAdmin() || true) // FIXME: Add proper role check. Allowing true for demo sake
      );
    }
  }
}

